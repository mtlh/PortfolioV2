{
  "preset": "mobile",
  "runs": 3,
  "urls": ["https://mtlh.vercel.app"],
  "budgets": {
    "lcp": {
      "max": 2500,
      "regression": 10
    },
    "cls": {
      "max": 0.05,
      "regression": 20
    },
    "tbt": {
      "max": 200,
      "severity": "warn"
    },
    "js": {
      "max": 50000,
      "regression": 10
    },
    "images": {
      "max": 100000,
      "regression": 10
    },
    "requests": {
      "max": 56,
      "regression": 20
    },
    "a11y": {
      "maxViolations": 0,
      "maxNew": 0
    }
  },
  "report": {
    "outDir": ".pulse"
  }
}
