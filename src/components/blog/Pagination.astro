---
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import Button from '~/components/ui/Button.astro';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'Newer posts', nextText = 'Older posts' } = Astro.props;
---

{(prevUrl || nextUrl) && (
  <nav class="container flex" aria-label="Blog pagination">
    <div class="flex flex-row mx-auto container justify-between">
      {prevUrl && (
        <Button variant="tertiary" class="md:px-3 px-3 mr-2" href={getPermalink(prevUrl)}>
          <Icon name="tabler:chevron-left" class="w-6 h-6" aria-hidden="true" />
          <span class="ml-2">{prevText}</span>
        </Button>
      )}

      {nextUrl && (
        <Button variant="tertiary" class="md:px-3 px-3" href={getPermalink(nextUrl)}>
          <span class="mr-2">{nextText}</span>
          <Icon name="tabler:chevron-right" class="w-6 h-6" aria-hidden="true" />
        </Button>
      )}
    </div>
  </nav>
)}
