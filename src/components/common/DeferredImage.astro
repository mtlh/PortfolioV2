---
/**
 * An <img> that only starts downloading once it approaches the viewport.
 *
 * Chrome's native `loading="lazy"` eagerly fetches anything within ~1250px of
 * the viewport on 4G, so the skill icons and company logos that sit just below
 * the hero were competing with the LCP background for bandwidth on first load.
 * This component keeps the real URL in `data-aw-src` and swaps it in from a
 * single shared IntersectionObserver (see `DeferredImages.astro`), so the
 * below-the-fold images cost nothing until they are actually needed.
 *
 * The intrinsic width/height (taken from Astro's image metadata) reserve the
 * correct box up front, so hydrating the source later cannot shift layout.
 * A <noscript> copy keeps the images visible when JavaScript is unavailable.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  class?: string;
}

const { src, alt, width, height, widths, sizes, class: className } = Astro.props;

const image = await getImage({ src, width, height, widths, sizes });
const { attributes } = image;

// 1x1 transparent GIF: no network request, no broken-image icon.
const placeholder = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<img
  class={className}
  src={placeholder}
  data-aw-src={image.src}
  data-aw-srcset={image.srcSet.attribute || undefined}
  sizes={sizes}
  width={attributes.width}
  height={attributes.height}
  alt={alt}
  loading="lazy"
  decoding="async"
/>

<noscript>
  <img
    class={className}
    src={image.src}
    srcset={image.srcSet.attribute || undefined}
    sizes={sizes}
    width={attributes.width}
    height={attributes.height}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
</noscript>
