---
/**
 * Renders a skill icon from the page-level <SvgSprite /> as an inline <use>.
 *
 * The icons are decorative (their wrappers already expose a label), so the
 * generated <svg> is hidden from assistive technology. Render <SvgSprite />
 * once on any page that uses this component.
 */
import { svgIcons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  style?: string;
  width?: number | string;
  height?: number | string;
}

const { name, class: className, style, width, height } = Astro.props;
const { viewBox } = svgIcons[name];
---

<svg
  viewBox={viewBox}
  class={className}
  style={style}
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
>
  <use href={`#icon-${name}`} />
</svg>
