---
import { Icon } from 'astro-icon/components';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const socialLinks = [
  {
    ariaLabel: "Matthew Harvey's LinkedIn profile (opens in a new tab)",
    href: 'https://www.linkedin.com/in/mtlh/',
    icon: 'tabler:brand-linkedin',
  },
  {
    ariaLabel: "Matthew Harvey's GitHub profile (opens in a new tab)",
    href: 'https://github.com/mtlh/',
    icon: 'tabler:brand-github',
  },
  {
    ariaLabel: 'Email Matthew Harvey',
    href: 'mailto:matthewtlharvey@gmail.com',
    icon: 'tabler:mail-forward',
  },
  {
    ariaLabel: "Download Matthew Harvey's CV (PDF)",
    href: '/MatthewHarveyCV.pdf',
    icon: 'tabler:file-info',
    isExternal: false,
  },
];
---

<ul class:list={['flex items-center leading-none', className]}>
  {socialLinks.map((link) => (
    <li>
      <a
        class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary rounded-lg text-sm p-2.5 inline-flex items-center"
        aria-label={link.ariaLabel}
        href={link.href}
        data-astro-prefetch={link.href.endsWith('.pdf') ? 'false' : undefined}
        target={link.isExternal !== false ? '_blank' : undefined}
        rel={link.isExternal !== false ? 'noopener noreferrer' : undefined}
      >
        <Icon name={link.icon} class="w-5 h-5" aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>
