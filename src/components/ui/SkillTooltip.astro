---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  class="group relative inline-block w-fit justify-self-center rounded-sm text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
  tabindex="0"
  role="group"
  aria-label={label}
>
  <slot />
  <span
    class="pointer-events-none absolute bottom-0 right-0 z-20 hidden translate-x-1/2 translate-y-1/2 whitespace-nowrap rounded-md bg-linear-to-r from-blue-500 to-blue-600 px-2 py-1 text-xs leading-none text-white shadow-lg group-hover:block group-focus:block"
    role="tooltip"
  >
    {label}
  </span>
</div>
