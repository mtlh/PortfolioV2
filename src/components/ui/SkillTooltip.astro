---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 hidden -translate-x-1/2 flex-col items-center group-hover:flex group-focus:flex"
  role="tooltip"
>
  <span class="relative z-10 whitespace-nowrap rounded-lg bg-linear-to-r from-blue-500 to-blue-600 p-2 text-xs leading-none text-white shadow-lg">
    {label}
  </span>
  <div class="-mt-1.5 h-3 w-3 rotate-45 bg-linear-to-r from-blue-500 to-blue-600" aria-hidden="true"></div>
</div>
