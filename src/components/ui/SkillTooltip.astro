---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  class="pointer-events-none absolute left-full top-full z-20 hidden -translate-x-2 -translate-y-2 group-hover:block group-focus:block"
  role="tooltip"
>
  <span class="block whitespace-nowrap rounded-md bg-linear-to-r from-blue-500 to-blue-600 px-2 py-1 text-xs leading-none text-white shadow-lg">
    {label}
  </span>
</div>
