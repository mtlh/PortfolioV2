---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

{/*
  The label is purely a visual cue: every skill image already carries the same
  text as its `alt`. The wrapper is not focusable and the tooltip is hidden
  from assistive technology so a screen reader user is not given dozens of
  redundant tab stops and duplicate announcements.
*/}
<div class:list={['group relative inline-block w-fit justify-self-center rounded-sm', className]}>
  <slot />
  <span
    class="pointer-events-none absolute bottom-0 right-0 z-20 hidden translate-x-1/2 translate-y-1/2 whitespace-nowrap rounded-md bg-linear-to-r from-blue-600 to-blue-700 px-2 py-1 text-xs leading-none text-white shadow-lg group-hover:block group-focus-within:block"
    aria-hidden="true"
  >
    {label}
  </span>
</div>
