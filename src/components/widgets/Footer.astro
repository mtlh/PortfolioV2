---
import ToggleTheme from '../common/ToggleTheme.astro';
import SocialLinks from '../common/SocialLinks.astro';
import type { Widget } from '~/types';
import { APP_BLOG } from 'astrowind:config';
import { findLatestPosts } from '~/utils/blog';
import { getBlogPermalink, getHomePermalink } from '~/utils/permalinks';

export interface Props extends Widget {
  title?: string;
  linkText?: string;
  linkUrl?: string | URL;
  information?: string;
  count?: number;
}

const { count = 3 } = Astro.props;

const posts = APP_BLOG.isEnabled ? await findLatestPosts({ count }) : [];
---

<footer class="border-t border-gray-200 dark:border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 gap-y-4 sm:gap-8 py-6">
      <nav aria-labelledby="footer-site-heading" class="text-gray-800 dark:text-gray-300 mb-2 text-md">
        <h2 id="footer-site-heading">
          <a href={getHomePermalink()} class="underline">
            Home
          </a>
        </h2>
        <ul class="py-2 text-sm">
          <li class="mb-2">
            <a
              class="text-gray-600 hover:text-gray-700 dark:text-gray-400 dark:hover:text-slate-100 transition duration-150 ease-in-out"
              href={`${getHomePermalink()}#skills`}
            >
              Skills
            </a>
          </li>
          <li class="mb-2">
            <a
              class="text-gray-600 hover:text-gray-700 dark:text-gray-400 dark:hover:text-slate-100 transition duration-150 ease-in-out"
              href={`${getHomePermalink()}#history`}
            >
              My Journey
            </a>
          </li>
          <li class="mb-2">
            <a
              class="text-gray-600 hover:text-gray-700 dark:text-gray-400 dark:hover:text-slate-100 transition duration-150 ease-in-out"
              href={`${getHomePermalink()}#projects`}
            >
              Featured Projects
            </a>
          </li>
        </ul>
      </nav>
      <nav aria-labelledby="footer-blog-heading" class="text-gray-800 dark:text-gray-300 mb-2 text-md">
        <h2 id="footer-blog-heading">
          <a href={getBlogPermalink()} class="underline">
            Blog
          </a>
        </h2>
        <ul class="py-2 text-sm">
          {posts.map((post) => (
            <li class="mb-2">
              <a
                class="text-gray-600 hover:text-gray-700 dark:text-gray-400 dark:hover:text-slate-100 transition duration-150 ease-in-out"
                href={`/${post.slug}`}
              >
                {post.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="text-gray-800 dark:text-gray-300 mb-1 sm:col-span-2 md:col-span-1">
        <h2 class="sr-only">Social and theme</h2>
        <div class="flex items-center gap-2 mb-4 sm:justify-end md:justify-start">
          <SocialLinks />
          <ToggleTheme />
        </div>
      </div>
    </div>
  </div>
</footer>
