---
import { Icon } from 'astro-icon/components';
import heroDevSvg from '~/assets/images/hero_dev.svg?url';
---

<section class="hero-section bg-cover bg-no-repeat bg-scroll flex items-center">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-6 md:py-20">
      <div class="text-center max-w-5xl mx-auto">
        <img
          class="mx-auto rounded-md w-[10rem] h-auto max-w-full md:w-[13rem] md:mb-6 mb-1"
          src={heroDevSvg}
          alt="Dev Thumb Icon"
          width={256}
          height={256}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <h1 class="text-6xl md:text-[4.50rem] font-bold leading-tighter tracking-tighter mb-4 font-heading text-black">
          Matthew Harvey
        </h1>
        <h2 class="text-3xl md:text-[2.50rem] font-bold leading-tighter tracking-tighter mb-4 font-heading">
          <span class="bg-clip-text text-transparent bg-linear-to-r from-primary to-primary sm:whitespace-nowrap">
            Software Engineer
          </span>
        </h2>
        <div class="max-w-3xl text-left mx-auto">
          <div class="max-w-none px-6 flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
            <div class="flex w-full sm:w-auto">
              <a
                class="btn text-white border border-gray-600 dark:bg-gray-70 bg-gray-900 hover:bg-gray-700 hover:border-gray-800 hover:scale-105 hover:shadow-lg sm:mb-0 w-full transition-transform"
                href="https://www.linkedin.com/in/mtlh/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Connect <Icon name="tabler:brand-linkedin" class="w-6 h-6 ml-1" />
              </a>
            </div>
            <div class="flex w-full sm:w-auto">
              <a
                class="btn text-white border border-primary bg-primary hover:bg-primary hover:border-primary hover:scale-105 hover:shadow-lg sm:mb-0 w-full transition-transform"
                href="#projects"
              >
                View Projects &DownArrow;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    /* Fill the viewport below the sticky 4rem header so the content sits centred. */
    min-height: calc(100vh - 4rem);
    min-height: calc(100svh - 4rem);
  }

  @media (max-height: 600px) and (max-width: 639px) {
    .hero-section > div > div {
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .hero-section img {
      width: 8rem;
      margin: 0 auto 0.25rem;
    }

    .hero-section h1 {
      font-size: 2.75rem;
      line-height: 1.05;
    }

    .hero-section h2 {
      font-size: 1.5rem;
      line-height: 1.1;
    }

    .hero-section .flex.flex-nowrap {
      gap: 0.5rem;
    }
  }
</style>
