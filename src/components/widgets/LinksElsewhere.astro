---
import { Icon } from 'astro-icon/components';
---

<section class="relative scroll-mt-16 bg-light py-10" id="links">
  <div class="max-w-xl mb-10 md:mx-auto text-center lg:max-w-2xl md:mb-12">
    <p class="text-base text-primary dark:text-primary-soft font-semibold tracking-wide uppercase">My Links</p>
    <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter font-heading">
      Want to see me elsewhere?
    </h2>
  </div>
  <div class="max-w-screen-md mx-auto">
    <div class="mx-auto max-w-xs">
      <div class="grid grid-cols-2 gap-4 m-auto">
        <a
          class="text-center dark:md:border-slate-500 mb-2 md:mb-0 items-center inline-block text-gray-500 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg"
          href="https://github.com/mtlh/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="text-xl font-bold lg:text-xl xl:text-2xl text-primary dark:text-primary-soft hover:text-primary dark:hover:text-primary-soft font-heading items-center grid grid-cols-3">
            <Icon name="tabler:brand-github" class="h-12 w-12 grid-cols-1" aria-hidden="true" />
            <span class="text-left grid-cols-2">
              GitHub<span class="sr-only"> (opens in a new tab)</span>
            </span>
          </span>
        </a>
        <a
          class="text-center dark:md:border-slate-500 mb-2 md:mb-0 items-center inline-block text-gray-500 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg"
          href="https://www.linkedin.com/in/mtlh/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="text-xl font-bold lg:text-xl xl:text-2xl text-primary dark:text-primary-soft hover:text-primary dark:hover:text-primary-soft font-heading items-center grid grid-cols-3">
            <Icon name="tabler:brand-linkedin" class="w-12 h-12 grid-cols-1" aria-hidden="true" />
            <span class="text-left grid-cols-2">
              LinkedIn<span class="sr-only"> (opens in a new tab)</span>
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
