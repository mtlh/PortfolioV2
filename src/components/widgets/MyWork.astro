---
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import DeferredImage from '~/components/common/DeferredImage.astro';
import SkillTooltip from '~/components/ui/SkillTooltip.astro';

import access from '~/assets/work/access.svg';
import lcc from '~/assets/work/lcc.svg';
import serco from '~/assets/work/serco.svg';
import dmu from '~/assets/work/dmu.svg';

import iconCsharp from '~/assets/skills/icons/csharp-original.svg';
import iconDotnet from '~/assets/skills/icons/dotnetcore-original.svg';
import iconTerraform from '~/assets/skills/icons/terraform-original.svg';
import iconReact from '~/assets/skills/icons/react-original.svg';
import iconTypescript from '~/assets/skills/icons/typescript-original.svg';
import iconGraphql from '~/assets/skills/icons/graphql-plain.svg';
import iconMssql from '~/assets/skills/icons/microsoftsqlserver-plain.svg';
import iconPostgres from '~/assets/skills/icons/postgresql-original.svg';
import iconHtml from '~/assets/skills/icons/html5-original.svg';
import iconCss from '~/assets/skills/icons/css3-original.svg';
import iconJavascript from '~/assets/skills/icons/javascript-plain.svg';
import iconPhp from '~/assets/skills/icons/php-plain.svg';
import iconScala from '~/assets/skills/icons/scala-original.svg';
import iconJava from '~/assets/skills/icons/java-original.svg';
import iconSql from '~/assets/skills/icons/mysql-original.svg';
import iconGit from '~/assets/skills/icons/git-original.svg';

type Skill = {
  src: ImageMetadata;
  label: string;
};

type WorkEntry = {
  title: string;
  company: string | null;
  companyUrl: string | null;
  image: ImageMetadata | null;
  dates: string;
  skills: Skill[] | null;
  description: string | null;
  descriptionHidden?: boolean;
};

type EducationEntry = {
  title: string;
  institution: string;
  institutionUrl: string;
  image: ImageMetadata;
  dates: string;
  award: string;
  skills: Skill[];
  description: string;
};

const workEntries: WorkEntry[] = [
  {
    title: 'Junior Software Engineer',
    company: null,
    companyUrl: null,
    image: null,
    dates: 'March 2025 - Present',
    skills: [
      { src: iconCsharp, label: 'C#' },
      { src: iconTerraform, label: 'Terraform' },
    ],
    description: null,
  },
  {
    title: 'Graduate Software Engineer',
    company: 'Access',
    companyUrl: 'https://www.theaccessgroup.com/en-gb/',
    image: access,
    dates: 'August 2024 - March 2025',
    skills: [
      { src: iconReact, label: 'React' },
      { src: iconTypescript, label: 'TypeScript' },
      { src: iconGraphql, label: 'GraphQL' },
      { src: iconCsharp, label: 'C#' },
      { src: iconMssql, label: 'SQL Server' },
    ],
    description: null,
    descriptionHidden: true,
  },
  {
    title: 'Placement Technical Specialist',
    company: 'Leicestershire County Council',
    companyUrl: 'https://www.leicestershire.gov.uk/',
    image: lcc,
    dates: 'June 2022 - August 2023',
    skills: [
      { src: iconCsharp, label: 'C#' },
      { src: iconDotnet, label: '.NET' },
      { src: iconPostgres, label: 'PostgreSQL' },
    ],
    description:
      'Built responsive webservices reducing existing API times by over 60%. Automated scheduled tasks by managing geographical data sourced from the Ordance Survey API. Created and maintained various web forms used by all aspects of the business.',
  },
  {
    title: 'Customer Service Advisor',
    company: 'Serco',
    companyUrl: 'https://www.serco.com/',
    image: serco,
    dates: 'May 2020 - September 2020',
    skills: null,
    description:
      'Conducted outbound calls to a person in contact with another individual that has received a positive coronavirus test to advise them to self-isolate, as part of the NHS COVID-19 contact tracing programme.',
  },
];

const educationEntries: EducationEntry[] = [
  {
    title: 'BSc Computer Science with Placement Year',
    institution: 'De Montfort University',
    institutionUrl: 'https://www.dmu.ac.uk/',
    image: dmu,
    dates: 'September 2020 - June 2024',
    award: '2023 Placement Student Of The Year',
    skills: [
      { src: iconHtml, label: 'HTML' },
      { src: iconCss, label: 'CSS' },
      { src: iconJavascript, label: 'JavaScript' },
      { src: iconPhp, label: 'PHP' },
      { src: iconScala, label: 'Scala' },
      { src: iconJava, label: 'Java' },
      { src: iconSql, label: 'SQL' },
      { src: iconGit, label: 'Git' },
    ],
    description:
      'Relevant Modules Include: Object Oriented, Agile Team Development, Data Structures and Algorithms, Web Applications...',
  },
];
---

<section class="px-4 py-8 sm:px-6 mx-auto xl:px-8 xl:py-10 max-w-6xl scroll-mt-20" id="history">
  <div class="grid gap-6 row-gap-10 xl:grid-cols-1">
    <div class="xl:pb-6">
      <h2 class="mb-8 text-3xl xl:text-4xl font-bold font-heading">Work History</h2>
      {workEntries.map((entry, i) => (
        <div class="flex">
          <div class="flex flex-col items-center mr-4">
            <div>
              <div
                class={
                  i === 0
                    ? 'flex items-center justify-center w-10 h-10 rounded-full bg-linear-to-r from-blue-500 to-blue-600 border-2'
                    : 'flex items-center justify-center w-10 h-10 rounded-full border-blue-500 border-2'
                }
              >
                <Icon
                  name={i === 0 ? 'tabler:at' : 'tabler:arrow-up'}
                  class={
                    i === 0 ? 'w-6 h-6 text-slate-200 icon-bold' : 'w-6 h-6 text-gray-600 dark:text-slate-200 icon-bold'
                  }
                />
              </div>
            </div>
            <div class="w-px h-full bg-gray-300 dark:bg-slate-500" />
          </div>
          <div class="pt-1 pb-8 grid grid-flow-col w-full xl:grid-cols-4 items-start xl:items-center">
            <div class="col-span-4 xl:col-span-3 min-w-full">
              <p class="mb-2 text-xl font-bold text-gray-900 dark:text-slate-300">{entry.title}</p>
              {entry.image ? (
                <DeferredImage
                  class="visible xl:hidden w-60"
                  src={entry.image}
                  sizes="240px"
                  alt={entry.company ?? ''}
                />
              ) : null}
              {entry.company ? (
                <p class="mb-2 text-lg font-medium text-primary dark:text-primary-soft underline">
                  <a href={entry.companyUrl} target="_blank" rel="noopener noreferrer">
                    {entry.company}
                  </a>
                </p>
              ) : null}
              <span class="inline text-lg font-medium text-gray-900 dark:text-slate-300 my-1">
                <Icon name="tabler:calendar-time" class="w-6 h-6 icon-bold inline" />
                <p class="inline">{entry.dates}</p>
              </span>
              <br />
              {entry.skills ? (
                <div class="flex flex-wrap items-center gap-3 mt-1">
                  {entry.skills.map((skill) => (
                    <SkillTooltip label={skill.label}>
                      <DeferredImage src={skill.src} alt={skill.label} width={48} height={48} class="w-8 h-8" />
                    </SkillTooltip>
                  ))}
                </div>
              ) : null}
              {entry.description && !entry.descriptionHidden ? <p class="py-2 max-w-2xl">{entry.description}</p> : null}
            </div>
            {entry.image ? (
              <div class="col-span-4 xl:col-span-1 ml-10">
                <DeferredImage
                  class="hidden xl:flex w-full"
                  src={entry.image}
                  sizes="260px"
                  alt={entry.company ?? ''}
                />
              </div>
            ) : null}
          </div>
        </div>
      ))}
      <div class="xl:pb-6 pt-6">
        <h2 class="mb-8 text-3xl xl:text-4xl font-bold font-heading">Education</h2>
        {educationEntries.map((ed) => (
          <div class="flex">
            <div class="flex flex-col items-center mr-4">
              <div>
                <div class="flex items-center justify-center w-10 h-10 rounded-full border-blue-500 border-2">
                  <Icon name="tabler:arrow-up" class="w-6 h-6 text-gray-600 dark:text-slate-200 icon-bold" />
                </div>
              </div>
              <div class="w-px h-full bg-gray-300 dark:bg-slate-500" />
            </div>
            <div class="pt-1 pb-8 grid grid-flow-col w-full xl:grid-cols-4 items-start xl:items-center">
              <div class="col-span-4 xl:col-span-3 min-w-full">
                <p class="mb-2 text-xl font-bold text-gray-900 dark:text-slate-300">{ed.title}</p>
                {ed.image ? (
                  <DeferredImage
                    class="visible xl:hidden w-60"
                    src={ed.image}
                    sizes="240px"
                    alt={ed.institution ?? ''}
                  />
                ) : null}
                <p class="mb-2 text-lg font-medium text-primary dark:text-primary-soft underline">
                  <a href={ed.institutionUrl} target="_blank" rel="noopener noreferrer">
                    {ed.institution}
                  </a>
                </p>
                <span class="inline text-lg font-medium text-gray-900 dark:text-slate-300">
                  <Icon name="tabler:calendar-time" class="w-6 h-6 icon-bold inline" />
                  <p class="inline">{ed.dates}</p>
                </span>
                <br />
                {ed.award ? (
                  <span class="inline text-lg font-medium text-gray-900 dark:text-slate-300">
                    <Icon name="tabler:award" class="w-6 h-6 icon-bold inline" />
                    <p class="inline">{ed.award}</p>
                  </span>
                ) : null}
                <br />
                {ed.skills ? (
                  <div class="flex flex-wrap items-center gap-3 mt-1">
                    {ed.skills.map((skill) => (
                      <SkillTooltip label={skill.label}>
                        {/* 100px keeps the same optimized asset URL as Skills/Extras, so these icons add no extra requests. */}
                        <DeferredImage src={skill.src} alt={skill.label} width={100} height={100} class="w-8 h-8" />
                      </SkillTooltip>
                    ))}
                  </div>
                ) : null}
                {ed.description ? <p class="py-2 max-w-2xl">{ed.description}</p> : null}
              </div>
              {ed.image ? (
                <div class="col-span-4 xl:col-span-1 ml-10">
                  <DeferredImage
                    class="hidden xl:flex w-full"
                    src={ed.image}
                    sizes="260px"
                    alt={ed.institution ?? ''}
                  />
                </div>
              ) : null}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
