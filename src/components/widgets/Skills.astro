---
import { Image } from 'astro:assets';
import InlineSvg from '~/components/common/InlineSvg.astro';
import type { IconName } from '~/components/common/icons';

type Skill = {
  icon?: IconName;
  label: string;
  dual?: boolean;
  iconLight?: IconName;
  iconDark?: IconName;
};

// Centralised skill data for easy editing
const frontend: Skill[] = [
  { icon: 'html5', label: 'HTML' },
  { icon: 'css3', label: 'CSS' },
  { icon: 'javascript', label: 'JavaScript' },
  { icon: 'typescript', label: 'TypeScript' },
  { icon: 'react', label: 'React' },
  { icon: 'tailwind', label: 'Tailwind' },
  { icon: 'bootstrap', label: 'Bootstrap' },
  { icon: 'materialui', label: 'MaterialUI' },
  { dual: true, iconLight: 'astro-light', iconDark: 'astro-dark', label: 'Astro' },
  { icon: 'sass', label: 'SASS' },
];

const backend: Skill[] = [
  { icon: 'mysql', label: 'MySQL' },
  { icon: 'python', label: 'Python' },
  { icon: 'nodejs', label: 'NodeJS' },
  { icon: 'java', label: 'Java' },
  { icon: 'scala', label: 'Scala' },
  { dual: true, iconLight: 'prisma-light', iconDark: 'prisma-dark', label: 'Prisma' },
  { icon: 'firebase', label: 'Firebase' },
  { icon: 'nextjs', label: 'Nextjs' },
  { icon: 'csharp', label: 'C#' },
  { icon: 'dotnet', label: '.NET' },
];

const tools: Skill[] = [
  { icon: 'git', label: 'Git' },
  { icon: 'markdown', label: 'Markdown' },
  { icon: 'npm', label: 'NPM' },
  { icon: 'webpack', label: 'Webpack' },
  { icon: 'vscode', label: 'VS Code' },
  { icon: 'visualstudio', label: 'Visual Studio' },
  { icon: 'canva', label: 'Canva' },
  { icon: 'nuget', label: 'Nuget' },
];
---

<section class="relative scroll-mt-20" id="skills">
  <div class="absolute inset-0 bg-light pointer-events-none mb-32" aria-hidden="true"></div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-4 pt-8 sm:py-6 lg:py-8 lg:pt-10">
      <div class="mb-8 text-center">
        <p class="text-base text-primary dark:text-primary font-semibold tracking-wide uppercase">Skills</p>
        <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">What I Know</h2>
        <p class="max-w-3xl mx-auto text-center text-xl text-muted dark:text-muted">
          From frontend to backend and additional tools. Below is a selection of the technologies I regularly work with.
        </p>
      </div>
      <div class="relative mb-0 m-auto max-w-6xl">
        <a href="https://github.com/mtlh" target="_blank" class="cursor-pointer">
          <Image
            loading="lazy"
            decoding="async"
            class="mx-auto rounded-md w-full"
            src="https://ghchart.rshah.org/mtlh"
            alt="Matthew Harvey GitHub chart"
            width={900}
            height={120}
          />
        </a>
      </div>
      <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3 my-12 dark:text-white">
        {[
          { title: 'Frontend', items: frontend },
          { title: 'Backend', items: backend },
          { title: 'Tools', items: tools },
        ].map((section) => (
          <div class="relative flex h-full flex-col p-6 bg-white dark:bg-slate-900 rounded shadow-xl hover:shadow-lg transition dark:border dark:border-slate-800 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <div class="flex items-center mb-4">
              <div class="text-2xl font-bold">{section.title}</div>
            </div>
            <div class="grid max-w-none sm:grid-cols-4 grid-cols-5 sm:flex-row sm:justify-center gap-4">
              {section.items.map((skill) => (
                <div
                  class="group relative inline-block rounded-sm text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
                  tabindex="0"
                  role="group"
                  aria-label={skill.label}
                >
                  {skill.dual && skill.iconLight && skill.iconDark ? (
                    <>
                      <InlineSvg name={skill.iconLight} class="max-h-12 block w-4/5 dark:hidden" />
                      <InlineSvg name={skill.iconDark} class="max-h-12 w-4/5 hidden dark:block" />
                    </>
                  ) : skill.icon ? (
                    <InlineSvg name={skill.icon} class="md:w-12 md:h-12 w-16 h-16" />
                  ) : null}
                  <div class="absolute bottom-0 flex-col items-center hidden mb-8 group-hover:flex group-focus:flex z-10">
                    <span class="relative z-10 p-3 text-xs leading-none rounded-lg text-white whitespace-nowrap bg-linear-to-r from-blue-500 to-blue-600 shadow-lg">
                      {skill.label}
                    </span>
                    <div class="w-3 h-3 -mt-2 rotate-45 bg-linear-to-r from-blue-500 to-blue-600" />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
